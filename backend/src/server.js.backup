// ========== DASHBOARD (with chartData for buyer) ==========
app.get('/api/dashboard', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const userId = decoded.id;
    const role = decoded.role;
    if (role === 'buyer') {
      const activeRFQs = await pool.query('SELECT COUNT(*) FROM rfqs WHERE buyer_id = $1 AND status = $2', [userId, 'open']);
      const pendingQuotes = await pool.query('SELECT COUNT(*) FROM quotes WHERE rfq_id IN (SELECT id FROM rfqs WHERE buyer_id = $1) AND status = $2', [userId, 'pending']);
      const activeOrders = await pool.query('SELECT COUNT(*) FROM purchase_orders WHERE buyer_id = $1 AND status NOT IN ($2,$3)', [userId, 'delivered', 'cancelled']);
      const totalSpent = await pool.query('SELECT COALESCE(SUM(total_amount),0) FROM purchase_orders WHERE buyer_id = $1 AND status = $2', [userId, 'delivered']);
      const recentRFQs = await pool.query('SELECT id, rfq_number, title, part_name, quantity, status, created_at FROM rfqs WHERE buyer_id = $1 ORDER BY created_at DESC LIMIT 5', [userId]);
      const recentOrders = await pool.query('SELECT id, po_number, supplier_name, total_amount, status, created_at FROM purchase_orders WHERE buyer_id = $1 ORDER BY created_at DESC LIMIT 5', [userId]);

      // Chart data: monthly orders (last 6 months) and order status distribution
      const monthlyOrders = await pool.query(`
        SELECT TO_CHAR(created_at, 'Mon') as month, COUNT(*) as orders, COALESCE(SUM(total_amount),0) as spend
        FROM purchase_orders
        WHERE buyer_id = $1 AND created_at > NOW() - INTERVAL '6 months'
        GROUP BY TO_CHAR(created_at, 'Mon'), EXTRACT(MONTH FROM created_at)
        ORDER BY EXTRACT(MONTH FROM created_at) ASC
      `, [userId]);
      
      const statusResult = await pool.query(`
        SELECT status, COUNT(*) as count
        FROM purchase_orders
        WHERE buyer_id = $1
        GROUP BY status
      `, [userId]);
      
      const statusColors = {
        issued: '#3b82f6',
        accepted: '#10b981',
        production: '#f59e0b',
        shipped: '#8b5cf6',
        delivered: '#10b981',
        cancelled: '#ef4444'
      };
      const chartData = {
        monthly: monthlyOrders.rows,
        status: statusResult.rows.map(s => ({
          name: s.status.charAt(0).toUpperCase() + s.status.slice(1),
          value: parseInt(s.count),
          color: statusColors[s.status] || '#6b7280'
        }))
      };

      res.json({
        stats: {
          activeRFQs: parseInt(activeRFQs.rows[0].count),
          pendingQuotes: parseInt(pendingQuotes.rows[0].count),
          activeOrders: parseInt(activeOrders.rows[0].count),
          totalSpent: parseFloat(totalSpent.rows[0].sum)
        },
        recentRFQs: recentRFQs.rows,
        recentOrders: recentOrders.rows,
        chartData
      });
    } else if (role === 'supplier') {
      const availableRFQs = await pool.query('SELECT COUNT(*) FROM rfqs WHERE status = $1', ['open']);
      const submittedQuotes = await pool.query('SELECT COUNT(*) FROM quotes WHERE supplier_id = $1', [userId]);
      const activeOrders = await pool.query('SELECT COUNT(*) FROM purchase_orders WHERE supplier_id = $1 AND status NOT IN ($2,$3)', [userId, 'delivered', 'cancelled']);
      const totalEarned = await pool.query('SELECT COALESCE(SUM(total_amount),0) FROM purchase_orders WHERE supplier_id = $1 AND status = $2', [userId, 'delivered']);
      res.json({
        stats: {
          availableRFQs: parseInt(availableRFQs.rows[0].count),
          submittedQuotes: parseInt(submittedQuotes.rows[0].count),
          activeOrders: parseInt(activeOrders.rows[0].count),
          totalEarned: parseFloat(totalEarned.rows[0].sum),
          rating: 4.5
        }
      });
    } else {
      res.status(403).json({ error: 'Invalid role' });
    }
  } catch (err) {
    console.error(err);
    res.status(401).json({ error: 'Invalid token' });
  }
});

