app.get('/api/supplier/pos', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json([]);
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const result = await pool.query('SELECT * FROM purchase_orders WHERE supplier_id = $1 ORDER BY created_at DESC', [decoded.id]);
    res.json(result.rows);
  } catch (err) {
    res.status(401).json([]);
  }
});

app.get('/api/supplier/pos/:id', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const result = await pool.query('SELECT * FROM purchase_orders WHERE id = $1 AND supplier_id = $2', [req.params.id, decoded.id]);
    if (result.rows.length === 0) return res.status(404).json({ error: 'Not found' });
    const milestones = await pool.query('SELECT * FROM milestones WHERE po_id = $1 ORDER BY "order"', [req.params.id]);
    const messages = await pool.query('SELECT * FROM messages WHERE po_id = $1 ORDER BY created_at', [req.params.id]);
    res.json({ ...result.rows[0], milestones: milestones.rows, messages: messages.rows });
  } catch (err) {
    res.status(401).json({ error: 'Unauthorized' });
  }
});

app.put('/api/supplier/pos/:poId/milestones/:milestoneId', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const { status, notes } = req.body;
    await pool.query(
      'UPDATE milestones SET status = $1::varchar, notes = $2::text, completed_at = CASE WHEN $1 = $3 THEN NOW() ELSE completed_at END WHERE id = $4 AND po_id IN (SELECT id FROM purchase_orders WHERE supplier_id = $5)',
      [status, notes || null, 'completed', req.params.milestoneId, decoded.id]
    );
    res.json({ success: true });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Update failed' });
  }
});

// ========== MESSAGES ==========
app.get('/api/messages/:poId', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json([]);
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const messages = await pool.query(
      `SELECT m.*, u.name as sender_name
       FROM messages m
       JOIN users u ON m.sender_id = u.id
       WHERE m.po_id = $1
       ORDER BY m.created_at ASC`,
      [req.params.poId]
    );
    res.json(messages.rows);
  } catch (err) {
    res.status(401).json([]);
  }
});

app.post('/api/messages/:poId', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const { content } = req.body;
    const user = await pool.query('SELECT name, role FROM users WHERE id = $1', [decoded.id]);
    const poProject = await pool.query('SELECT project_id FROM purchase_orders WHERE id = $1', [req.params.poId]);
    const projectId = poProject.rows[0]?.project_id;
    const result = await pool.query(
      `INSERT INTO messages (po_id, sender_id, sender_name, sender_role, content, created_at, project_id)
       VALUES ($1, $2, $3, $4, $5, NOW(), $6)
       RETURNING *`,
      [req.params.poId, decoded.id, user.rows[0].name, user.rows[0].role, content, projectId]
    );
    res.status(201).json(result.rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Failed to send message' });
  }
});

// ========== SIGNATURE ==========
app.post('/api/pos/:id/sign', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const { signature, role } = req.body;
    if (!signature || !role) return res.status(400).json({ error: 'Signature and role required' });
    if (role === 'buyer') {
      await pool.query('UPDATE purchase_orders SET buyer_signature = $1, buyer_signed_at = NOW() WHERE id = $2', [signature, req.params.id]);
    } else if (role === 'supplier') {
      await pool.query('UPDATE purchase_orders SET supplier_signature = $1, supplier_signed_at = NOW() WHERE id = $2', [signature, req.params.id]);
    } else {
      return res.status(400).json({ error: 'Invalid role' });
    }
    res.json({ success: true });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Failed to save signature' });
  }
});

// ========== DOCUMENTS ==========
app.post('/api/documents', upload.single('file'), async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const { entityId, entityType, type, project_id } = req.body;
    const file = req.file;
    if (!file) return res.status(400).json({ error: 'No file uploaded' });
    const result = await pool.query(
      `INSERT INTO documents (id, user_id, entity_id, entity_type, name, type, size, file_path, created_at, project_id)
       VALUES (gen_random_uuid(), $1, $2, $3, $4, $5, $6, $7, NOW(), $8)
       RETURNING *`,
      [decoded.id, entityId || null, entityType || null, file.originalname, type || 'other', file.size, file.path, project_id || null]
    );
    res.json(result.rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Upload failed' });
  }
});

app.get('/api/documents', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json([]);
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const { entityId, entityType, project_id } = req.query;
    let query = 'SELECT * FROM documents WHERE user_id = $1';
    const params = [decoded.id];
    if (project_id) {
      query += ' AND project_id = $2';
      params.push(project_id);
    } else if (entityId) {
      query += ' AND entity_id = $2';
      params.push(entityId);
      if (entityType) {
        query += ' AND entity_type = $3';
        params.push(entityType);
      }
    } else if (entityType) {
      query += ' AND entity_type = $2';
      params.push(entityType);
    }
    query += ' ORDER BY created_at DESC';
    const result = await pool.query(query, params);
    res.json(result.rows);
  } catch (err) {
    res.status(401).json([]);
  }
});

app.delete('/api/documents/:id', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const result = await pool.query('DELETE FROM documents WHERE id = $1 AND user_id = $2 RETURNING id', [req.params.id, decoded.id]);
    if (result.rowCount === 0) return res.status(404).json({ error: 'Not found' });
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ error: 'Delete failed' });
  }
});

