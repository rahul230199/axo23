const express = require('express');
const cors = require('cors');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const { Pool } = require('pg');
const dotenv = require('dotenv');
const multer = require('multer');
const fs = require('fs-extra');

dotenv.config();

const app = express();
const PORT = process.env.PORT || 5000;

const upload = multer({ dest: 'uploads/' });

const pool = new Pool({
  host: process.env.DB_HOST,
  port: process.env.DB_PORT,
  database: process.env.DB_NAME,
  user: process.env.DB_USER,
  password: process.env.DB_PASSWORD,
});

pool.connect((err) => {
  if (err) return console.error('❌ DB connection error:', err.message);
  console.log('✅ Connected to PostgreSQL');
});

app.use(cors({ origin: ['https://axonetworks.com', 'https://www.axonetworks.com', 'http://localhost:3000'], credentials: true }));
app.use(express.json());
app.use('/uploads', express.static('uploads'));

// ========== AUTH ==========
app.post('/api/auth/admin-login', (req, res) => {
  const { email, password } = req.body;
  if (email === 'admin@axonetworks.com' && password === 'admin123') {
    const token = jwt.sign({ id: 'admin_1', email, role: 'admin' }, process.env.JWT_SECRET || 'secret', { expiresIn: '7d' });
    return res.json({ success: true, token, user: { id: 'admin_1', email, name: 'Super Admin', role: 'admin' } });
  }
  res.status(401).json({ success: false, message: 'Invalid admin credentials' });
});

app.post('/api/auth/register', async (req, res) => {
  const { email, name, role, companyName, phone, address } = req.body;
  try {
    const existing = await pool.query('SELECT email FROM users WHERE email = $1', [email]);
    if (existing.rows.length > 0) return res.status(409).json({ success: false, message: 'User already exists' });
    await pool.query(
      `INSERT INTO pending_registrations (email, name, role, company_name, phone, address, registered_at)
       VALUES ($1, $2, $3, $4, $5, $6, NOW())`,
      [email, name, role, companyName || '', phone || '', address || '']
    );
    res.json({ success: true, message: 'Registration submitted for admin approval' });
  } catch (err) {
    console.error(err);
    res.status(500).json({ success: false, message: 'Server error' });
  }
});

app.post('/api/auth/login', async (req, res) => {
  const { email, password } = req.body;
  try {
    const result = await pool.query('SELECT * FROM users WHERE email = $1', [email]);
    const user = result.rows[0];
    if (!user) return res.status(401).json({ success: false, message: 'Invalid credentials' });
    const valid = await bcrypt.compare(password, user.password_hash);
    if (!valid) return res.status(401).json({ success: false, message: 'Invalid credentials' });
    const token = jwt.sign(
      { id: user.id, email: user.email, role: user.role },
      process.env.JWT_SECRET || 'secret',
      { expiresIn: '7d' }
    );
    res.json({
      success: true,
      token,
      needsReset: user.must_reset_password || false,
      user: { id: user.id, email: user.email, name: user.name, role: user.role }
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ success: false, message: 'Server error' });
  }
});

app.post('/api/auth/reset-password', async (req, res) => {
  const { token, newPassword } = req.body;
  if (!token || !newPassword) return res.status(400).json({ success: false, message: 'Token and new password are required.' });
  if (newPassword.length < 6) return res.status(400).json({ success: false, message: 'Password must be at least 6 characters.' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const hashedPassword = await bcrypt.hash(newPassword, 10);
    await pool.query('UPDATE users SET password_hash = $1, must_reset_password = false WHERE id = $2', [hashedPassword, decoded.id]);
    res.json({ success: true, message: 'Password reset successfully.' });
  } catch (err) {
    res.status(401).json({ success: false, message: 'Invalid or expired token.' });
  }
});

// ========== ADMIN ==========
app.get('/api/admin/pending-registrations', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ success: false });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    if (decoded.role !== 'admin') return res.status(403).json({ success: false });
    const result = await pool.query('SELECT id, email, name, role, company_name, phone, address, registered_at FROM pending_registrations');
    res.json({ success: true, pending: result.rows });
  } catch (err) {
    res.status(401).json({ success: false });
  }
});

app.post('/api/admin/approve-registration', async (req, res) => {
  const { registrationId } = req.body;
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ success: false });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    if (decoded.role !== 'admin') return res.status(403).json({ success: false });
    const pending = await pool.query('SELECT * FROM pending_registrations WHERE id = $1', [registrationId]);
    if (pending.rows.length === 0) return res.status(404).json({ success: false });
    const p = pending.rows[0];
    const username = `${p.name.toLowerCase().replace(/\s/g, '.')}@axonetworks.com`;
    const tempPassword = Math.random().toString(36).slice(-10) + Math.random().toString(36).slice(-10).toUpperCase();
    const hashedPassword = await bcrypt.hash(tempPassword, 10);
    const newUser = await pool.query(
      `INSERT INTO users (id, email, username, name, role, company_name, phone, address, password_hash, temp_password, must_reset_password, is_active, approved_at, created_at)
       VALUES (gen_random_uuid(), $1, $2, $3, $4, $5, $6, $7, $8, $9, true, true, NOW(), NOW())
       RETURNING id, email, username, name, role`,
      [p.email, username, p.name, p.role, p.company_name, p.phone, p.address, hashedPassword, tempPassword]
    );
    await pool.query('DELETE FROM pending_registrations WHERE id = $1', [registrationId]);
    res.json({ success: true, user: { ...newUser.rows[0], tempPassword } });
  } catch (err) {
    console.error(err);
    res.status(500).json({ success: false, error: err.message });
  }
});

app.post('/api/admin/reject-registration', async (req, res) => {
  const { registrationId } = req.body;
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ success: false });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    if (decoded.role !== 'admin') return res.status(403).json({ success: false });
    await pool.query('DELETE FROM pending_registrations WHERE id = $1', [registrationId]);
    res.json({ success: true });
  } catch (err) {
    res.status(500).json({ success: false });
  }
});

// ========== PROJECTS ==========
app.post('/api/projects', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const { name, description, industry, target_quantity, target_delivery_date, priority } = req.body;
    const projectNumber = `PRJ-${Date.now()}`;
    const result = await pool.query(
      `INSERT INTO projects (project_number, name, description, industry, target_quantity, target_delivery_date, priority, owner_id, status, created_at)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8, 'draft', NOW())
       RETURNING *`,
      [projectNumber, name, description, industry, target_quantity, target_delivery_date, priority, decoded.id]
    );
    res.status(201).json(result.rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Failed to create project' });
  }
});

app.get('/api/projects', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json([]);
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const result = await pool.query(
      `SELECT p.*, 
        (SELECT COUNT(*) FROM rfqs WHERE rfqs.project_id = p.id) as rfq_count,
        (SELECT COUNT(*) FROM quotes WHERE quotes.project_id = p.id) as quote_count,
        (SELECT COUNT(*) FROM purchase_orders WHERE purchase_orders.project_id = p.id) as po_count
       FROM projects p
       WHERE p.owner_id = $1
       ORDER BY p.created_at DESC`,
      [decoded.id]
    );
    res.json(result.rows);
  } catch (err) {
    res.status(401).json([]);
  }
});

app.get('/api/projects/:id', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const projectId = req.params.id;
    const project = await pool.query('SELECT * FROM projects WHERE id = $1 AND owner_id = $2', [projectId, decoded.id]);
    if (project.rows.length === 0) return res.status(404).json({ error: 'Project not found' });
    const rfqs = await pool.query('SELECT * FROM rfqs WHERE project_id = $1 ORDER BY created_at DESC', [projectId]);
    const quotes = await pool.query('SELECT * FROM quotes WHERE project_id = $1 ORDER BY submitted_at DESC', [projectId]);
    const pos = await pool.query('SELECT * FROM purchase_orders WHERE project_id = $1 ORDER BY created_at DESC', [projectId]);
    const messages = await pool.query('SELECT * FROM messages WHERE project_id = $1 ORDER BY created_at ASC', [projectId]);
    const documents = await pool.query('SELECT * FROM documents WHERE project_id = $1 ORDER BY created_at DESC', [projectId]);
    res.json({
      ...project.rows[0],
      rfqs: rfqs.rows,
      quotes: quotes.rows,
      purchase_orders: pos.rows,
      messages: messages.rows,
      documents: documents.rows
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Server error' });
  }
});

app.put('/api/projects/:id', async (req, res) => {
  const token = req.headers.authorization?.split(' ')[1];
  if (!token) return res.status(401).json({ error: 'Unauthorized' });
  try {
    const decoded = jwt.verify(token, process.env.JWT_SECRET || 'secret');
    const { name, description, industry, target_quantity, target_delivery_date, priority, status } = req.body;
    const result = await pool.query(
      `UPDATE projects SET 
        name = COALESCE($1, name),
        description = COALESCE($2, description),
        industry = COALESCE($3, industry),
        target_quantity = COALESCE($4, target_quantity),
        target_delivery_date = COALESCE($5, target_delivery_date),
        priority = COALESCE($6, priority),
        status = COALESCE($7, status),
        updated_at = NOW()
       WHERE id = $8 AND owner_id = $9
       RETURNING *`,
      [name, description, industry, target_quantity, target_delivery_date, priority, status, req.params.id, decoded.id]
    );
    if (result.rows.length === 0) return res.status(404).json({ error: 'Project not found' });
    res.json(result.rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: 'Update failed' });
  }
});

